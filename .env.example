# Optional. If unset, web_search falls back to DuckDuckGo (no key required).
# TAVILY_API_KEY=

# Inference endpoint. Defaults to localhost (SSH tunnel).
SURROGATE_BASE_URL=http://localhost:8000/v1
SURROGATE_MODEL=r1-distill-qwen-7b
# alternatives observed:
#   qwen2.5-7b                 — non-reasoning, native tool calling
#   r1-distill-qwen-7b         — DeepSeek R1 distill, emits <think>, tool calling is weak
#   r1-distill-llama-8b        — DO NOT USE: vLLM 0.20.2 detokenizer bug returns Ġ/Ċ bytes
