# ============================================================================
# .env.example  —  copy to .env and edit. .env is gitignored.
# ============================================================================

# --- Self-hosted surrogate (vLLM endpoint, reached via SSH tunnel) ----------
# When running on a single GPU with one model for BOTH stages, point STAGE1
# and STAGE2 at the same localhost endpoint and set SURROGATE_SKIP_SWAP=1
# to bypass the legacy model-swap code path entirely.
SURROGATE_SKIP_SWAP=1
STAGE1_BASE_URL=http://localhost:8000/v1
STAGE1_MODEL=qwen3-8b
STAGE2_BASE_URL=http://localhost:8000/v1
STAGE2_MODEL=qwen3-8b

# --- Reference model (z.ai Anthropic-compatible endpoint) ------------------
# Used by surrogate.reference and the backtest harness. The Coding Plan key
# works directly with the Anthropic-compatible endpoint — no Claude Code
# wrapper needed.
ZAI_API_KEY=               # put your z.ai key here (.env is gitignored)
ZAI_BASE_URL=https://api.z.ai/api/anthropic
REFERENCE_MODEL=glm-4.6    # alternatives: glm-5.1, glm-4.5-air
REFERENCE_THINKING_BUDGET=2048

# --- Optional: Tavily web search (search falls back to DuckDuckGo if unset) -
# TAVILY_API_KEY=

# ============================================================================
# Tunnel keeper (scripts/keep_tunnel.sh) — these are env vars, NOT loaded by
# python-dotenv. Set them in your shell when starting the tunnel; the script
# also has sane defaults pointing at the current box.
# ============================================================================
# Mithril (current):
#   TUNNEL_HOST=44.250.249.199  TUNNEL_USER=ubuntu  TUNNEL_PORT=22
#   TUNNEL_KEY=$HOME/ulusha-key.pem
# Old vast.ai (for reference):
#   TUNNEL_HOST=81.166.173.12   TUNNEL_USER=root    TUNNEL_PORT=10753
#   TUNNEL_KEY=""               # falls back to ssh-config
